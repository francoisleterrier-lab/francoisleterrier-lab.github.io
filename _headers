# En-têtes HTTP — Cloudflare Pages (ignoré par GitHub Pages, actif après migration).
# La CSP est adaptée aux ressources RÉELLEMENT chargées par le site (inventaire
# exhaustif + vérification adverse) : GA4/Tag Manager, Ahrefs, Calendly, Google
# Fonts, Looker Studio, web3forms, Pexels, et l'API Worker. Toute nouvelle
# intégration tierce devra être ajoutée à la directive correspondante.
#
# Rollout prudent : tester d'abord sur l'URL *.pages.dev, et au besoin passer la
# CSP en observation en renommant l'en-tête « Content-Security-Policy-Report-Only »
# le temps de vérifier la console, puis rebasculer en « Content-Security-Policy ».
# NB : /api/* est servi par le Worker, qui pose ses propres en-têtes.

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; script-src 'self' 'unsafe-inline' https://analytics.ahrefs.com https://assets.calendly.com https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://assets.calendly.com https://fonts.googleapis.com; img-src 'self' data: https://analytics.ahrefs.com https://assets.calendly.com https://images.pexels.com https://region1.google-analytics.com https://s.wordpress.com https://www.google-analytics.com https://www.google.com https://www.googletagmanager.com; font-src 'self' data: https://assets.calendly.com https://fonts.gstatic.com; connect-src 'self' https://analytics.ahrefs.com https://analytics.google.com https://calendly.com https://main.francois-leterrier-cmw.workers.dev https://region1.google-analytics.com https://stats.g.doubleclick.net https://www.google-analytics.com https://www.googletagmanager.com; frame-src 'self' https://calendly.com https://datastudio.google.com https://lookerstudio.google.com https://www.google.com; media-src 'self'; form-action 'self' https://api.web3forms.com; manifest-src 'self'; worker-src 'self' blob:; upgrade-insecure-requests
